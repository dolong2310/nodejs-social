{
  "name": "nodejs-social",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "keywords": [],
  "author": "Long Do",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "clear && tsx watch --env-file=.env.development src/main.ts",
    "dev:staging": "tsx watch --env-file=.env.staging src/main.ts",
    "dev:prod": "tsx watch --env-file=.env.production src/main.ts",
    "build": "tsup",
    "build:clean": "rimraf ./dist && tsup",
    "start:dev": "node --env-file=.env.development dist/main.js",
    "start:staging": "node --env-file=.env.staging dist/main.js",
    "start:prod": "node --env-file-if-exists=.env.production dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run src/modules",
    "test:architecture": "vitest run test/architecture",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "db:migrate:mongo": "node --env-file=.env.development --import tsx src/infrastructure/persistence/mongodb/migrate.ts up",
    "db:migrate:postgres": "node --env-file=.env.development --import tsx src/infrastructure/persistence/postgres/migrate.ts up",
    "db:rollback:mongo": "node --env-file=.env.development --import tsx src/infrastructure/persistence/mongodb/migrate.ts down",
    "db:rollback:postgres": "node --env-file=.env.development --import tsx src/infrastructure/persistence/postgres/migrate.ts down",
    "db:migrations:pending:mongo": "node --env-file=.env.development --import tsx src/infrastructure/persistence/mongodb/migrate.ts pending",
    "db:migrations:pending:postgres": "node --env-file=.env.development --import tsx src/infrastructure/persistence/postgres/migrate.ts pending",
    "db:migrations:executed:mongo": "node --env-file=.env.development --import tsx src/infrastructure/persistence/mongodb/migrate.ts executed",
    "db:migrations:executed:postgres": "node --env-file=.env.development --import tsx src/infrastructure/persistence/postgres/migrate.ts executed",
    "db:migration:create:mongo": "node --env-file=.env.development --import tsx src/infrastructure/persistence/mongodb/migrate.ts create",
    "db:migration:create:postgres": "node --env-file=.env.development --import tsx src/infrastructure/persistence/postgres/migrate.ts create",
    "seed:create-admin-user:mongo": "node --env-file=.env.development --import tsx src/infrastructure/persistence/seed/mongo/create-admin-user.ts",
    "seed:permissions:mongo": "node --env-file=.env.development --import tsx src/infrastructure/persistence/seed/mongo/permissions.ts",
    "seed:fake-data:mongo": "node --env-file=.env.development --import tsx src/infrastructure/persistence/seed/mongo/fake-data.ts",
    "seed:create-admin-user:postgres": "node --env-file=.env.development --import tsx src/infrastructure/persistence/seed/postgres/create-admin-user.ts",
    "seed:permissions:postgres": "node --env-file=.env.development --import tsx src/infrastructure/persistence/seed/postgres/permissions.ts",
    "seed:fake-data:postgres": "node --env-file=.env.development --import tsx src/infrastructure/persistence/seed/postgres/fake-data.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/client-ses": "^3.1009.0",
    "@aws-sdk/lib-storage": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@faker-js/faker": "^10.3.0",
    "@longdoo/node-payment-gateway": "1.1.2",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.71.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "formidable": "^3.5.4",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.17.23",
    "mime": "^4.1.0",
    "mime-types": "^3.0.2",
    "mitt": "^3.0.1",
    "mongodb": "^7.1.0",
    "ms": "^2.1.3",
    "otpauth": "^9.5.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^4.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "slash": "^5.1.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "systeminformation": "^5.31.6",
    "ts-essentials": "^10.1.1",
    "umzug": "^3.8.3",
    "uuid": "^14.0.0",
    "valibot": "^1.3.1",
    "yaml": "^2.8.2",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/formidable": "^3.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/mime": "^3.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.20.0",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsarch": "^5.4.1",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  },
  "packageManager": "pnpm@11.0.0"
}
