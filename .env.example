NODE_ENV="development" # development | staging | production
APP_NAME="nodejs-social"
PORT="3000"
LOG_LEVEL="debug" # fatal | error | warn | info | debug | trace | silent
FRONTEND_URL=""
APP_URL=""

# CORS
CORS_ORIGINS=""

# Database
DATABASE_ADAPTER="mongo" # mongo | postgres

MONGO_URI=""
MONGO_SECONDARY_URI=""
MONGO_DB_NAME=""

POSTGRES_URI=""
POSTGRES_REPLICA_URIS=""
POSTGRES_SSL="false"

# Redis
REDIS_HOST=""
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# JWT
JWT_ALGO=""
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRES_IN="1m"
REFRESH_TOKEN_EXPIRES_IN="1d"

# API Key
API_KEY=""

# OTP
OTP_EXPIRES_AT=""

# Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# AWS
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET_NAME=""
# SES_FROM_ADDRESS=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_ADDRESS=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment sandbox (the adapters are pinned to provider test environments in every app environment)
PAYMENT_PUBLIC_BASE_URL="https://your-public-https-tunnel.example"
VNPAY_TMN_CODE=""
VNPAY_SECURE_SECRET=""
VNPAY_HOST="https://sandbox.vnpayment.vn"
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_STORE_ID="MomoTestStore"
MOMO_STORE_NAME="NodeJS Social Sandbox"

# Rate Limit
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# System Health
SYSTEM_HEALTH_MONITOR_ENABLED="1"
SYSTEM_HEALTH_CRON="*/5 * * * *"
SYSTEM_HEALTH_TIMEZONE="Asia/Ho_Chi_Minh"
SYSTEM_HEALTH_DISK_PATH="/"
SYSTEM_HEALTH_CPU_WARN="80"
SYSTEM_HEALTH_CPU_CRITICAL="90"
SYSTEM_HEALTH_RAM_WARN="80"
SYSTEM_HEALTH_RAM_CRITICAL="90"
SYSTEM_HEALTH_DISK_WARN="80"
SYSTEM_HEALTH_DISK_CRITICAL="90"
SYSTEM_HEALTH_PROCESS_MEMORY_WARN_MB="512"
SYSTEM_HEALTH_PROCESS_MEMORY_CRITICAL_MB="1024"
SYSTEM_HEALTH_ALERT_COOLDOWN_SECONDS="1800"
SYSTEM_HEALTH_ADMIN_EMAILS="user1@example.com,user2@example.com"
